import numpy as np

a = input("Enter 16 elements separated by space: ")
lst = list(map(int, a.split()))
if len(lst) != 16:
    print("Please enter exactly 16 elements.")
else:
    arr = np.array(lst).reshape(4, 4)
    print("\nOriginal 4x4 Array:")
    print(arr)
    print("\nFirst row:",arr[0])
    print("\nLast column:",arr[:, -1])


