import numpy as np

arr1 = np.random.randint(0, 10, (5, 3))
arr2 = np.random.randint(0, 10, (3, 2))

print("Matrix 1 (5x3):")
print(arr1)
print("\nMatrix 2 (3x2):")
print(arr2)

# Real matrix product (5x3) @ (3x2) → (5x2)
product = np.dot(arr1, arr2)
# or equivalently: product = arr1 @ arr2

print("\nProduct of two matrices (5x3 * 3x2 → 5x2):")
print(product)






