import numpy as np

arr = np.zeros((5, 5), dtype=int)
arr[0, :] = 1      
arr[-1, :] = 1    
arr[:, 0] = 1    
arr[:, -1] = 1    
print("5x5 Array with border 1s and inside 0s:")
print(arr)


