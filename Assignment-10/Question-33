import numpy as np

A = np.array([[2, 1],[1, 2]])
print("Matrix A:")
print(A)
eigenvalues, eigenvectors = np.linalg.eig(A)
print("\nEigenvalues:")
print(eigenvalues)
print("\nEigenvectors (columns):")
print(eigenvectors)


