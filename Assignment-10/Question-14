import numpy as np

A = np.array([[4, 7],[2, 6]])
A_inv = np.linalg.inv(A)
print("Matrix A:")
print(A)
print("\nInverse of A:")
print(A_inv)
print("\nVerification (A @ A_inv):")
print(A @ A_inv)


