class BankAccount :
        def __init__(self,account_holder,balance) :
            self.account_holder=account_holder
            self.balance=balance
        
        def deposit(self,amount) :
            self.balance=amount+self.balance
            return self.balance
        
        def withdraw(self,amount) :
            if (self.balance<amount) :
                print("Withdraw denied ")
            else :
                self.balance-=amount
                return self.balance
        
        def display_balance(self) :
            print("Name : ",self.account_holder,"\nCurrent Balance : ",self.balance)
        
n=input("Enter the name of account holder : ")
b=int(input("Enter the balance : "))
amt1=int(input("Enter the amount for deposite : "))
amt2=int(input("Enter the amount for withdraw : "))

acc1=BankAccount(n,b)
acc1.display_balance()
print("Balance after deposting ",amt1," is ",acc1.deposit(amt1))
print("Balance after withdrawing ",amt2," is ",acc1.withdraw(amt2))
acc1.display_balance()


