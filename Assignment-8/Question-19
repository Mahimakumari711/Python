class Time:
    def __init__(self, hour, minute, second):
        self.hour = hour
        self.minute = minute
        self.second = second

    def displayTime(self):
        print(f"{self.hour:02d}:{self.minute:02d}:{self.second:02d}")

    def addTime(self, other):
        sec = self.second + other.second
        carry_min = sec // 60
        sec = sec % 60
        
        minute = self.minute + other.minute + carry_min
        carry_hr = minute // 60
        minute = minute % 60
        hour = self.hour + other.hour + carry_hr
        return Time(hour, minute, sec)

print("Enter first time:")
