class Student:
    def __init__(self, name, roll, marks, branch, college):
        self.studName = name
        self.studRoll = roll
        self.studMarks = marks  
        self.studBranch = branch
        self.studCollegeName = college

    def averageMarks(self):
        return sum(self.studMarks) / len(self.studMarks)

    def dispStudentDetails(self):
        print("\n--- Student Details ---")
        print("Name:", self.studName)
        print("Roll No:", self.studRoll)
        print("Branch:", self.studBranch)
        print("College:", self.studCollegeName)
        print("Marks:", self.studMarks)
        print("Average Marks:", self.averageMarks())

students = []
for i in range(10):
    print(f"\nEnter details for Student {i+1}")
    
    name = input("Enter Name: ")
    roll = input("Enter Roll No: ")
    branch = input("Enter Branch: ")
    college = input("Enter College Name: ")
    marks = []
    print("Enter marks for 5 subjects:")
    for j in range(5):
        m = float(input(f"Subject {j+1}: "))
        marks.append(m)
    s = Student(name, roll, marks, branch, college)
    students.append(s)

top_student = students[0]
for s in students:
    if s.averageMarks() > top_student.averageMarks():
        top_student = s

print("\nStudent with Highest Average Marks:")
top_student.dispStudentDetails()


