class Car :
    def __init__(self,brand,model,year) :
        self.brand=brand
        self.model=model
        self.year=year
    def show_details(self) :
        print("Brand of car : ",self.brand,"\nModel of car : ",self.model,"\nYear of car : ",self.year)
        
        
b=input("Enter the brand of car : ")
m=input("Enter the model of car : ")
y=int(input("Enter the year of car : "))
c1=Car(b,m,y)
c1.show_details()


