class BankAccount:
    def __init__(self, accountNumber, accHolderName, accBalance, accType):
        self.accountNumber = accountNumber
        self.accHolderName = accHolderName
        self.accBalance = accBalance
        self.accType = accType

    def deposit(self, amount):
        if amount > 0:
            self.accBalance += amount
            print(f"Deposited: {amount}")
        else:
            print("Invalid deposit amount")

    def withdraw(self, amount):
        if amount > self.accBalance:
            print("Insufficient balance!")
        elif amount <= 0:
            print("Invalid withdrawal amount")
        else:
            self.accBalance -= amount
            print(f"Withdrawn: {amount}")

    def displayAccountDetails(self):
        print("\n--- Account Details ---")
        print("Account Number:", self.accountNumber)
        print("Account Holder Name:", self.accHolderName)
        print("Account Type:", self.accType)
        print("Account Balance:", self.accBalance)

acc_no = input("Enter Account Number: ")
name = input("Enter Account Holder Name: ")
balance = float(input("Enter Initial Balance: "))
acc_type = input("Enter Account Type (Saving/Current): ")

account = BankAccount(acc_no, name, balance, acc_type)

while True:
    print("\n1. Deposit")
    print("2. Withdraw")
    print("3. Display Account Details")
    print("4. Exit")

    choice = input("Enter your choice: ")

    if choice == '1':
        amt = float(input("Enter amount to deposit: "))
        account.deposit(amt)

    elif choice == '2':
        amt = float(input("Enter amount to withdraw: "))
        account.withdraw(amt)

    elif choice == '3':
        account.displayAccountDetails()

    elif choice == '4':
        print("Exiting...")
        break

    else:
        print("Invalid choice!")


