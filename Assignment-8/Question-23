class Employee:
    def __init__(self, name, number, basicSal, DA, HRA):
        self.empName = name
        self.empNumber = number
        self.basicSal = basicSal
        self.DA = DA
        self.HRA = HRA

    def calGrossSal(self):
        return self.basicSal + self.DA + self.HRA

    def showEmpDetails(self):
        print("\n--- Employee Details ---")
        print("Name:", self.empName)
        print("Employee Number:", self.empNumber)
        print("Basic Salary:", self.basicSal)
        print("DA:", self.DA)
        print("HRA:", self.HRA)
        print("Gross Salary:", self.calGrossSal())

employees = []
n = int(input("Enter number of employees: "))

for i in range(n):
    print(f"\nEnter details for Employee {i+1}")
    name = input("Enter Name: ")
    number = input("Enter Employee Number: ")
    basic = float(input("Enter Basic Salary: "))
    da = float(input("Enter DA: "))
    hra = float(input("Enter HRA: "))
    
    emp = Employee(name, number, basic, da, hra)
    employees.append(emp)

print("\nEmployees with Gross Salary > 50000:")
found = False
for emp in employees:
    if emp.calGrossSal() > 50000:
        emp.showEmpDetails()
        found = True
if not found:
    print("No employee has gross salary more than 50000.")


