count=0
for i in range (1,101) :
    rev=0
    num=i
    while(num>0):
        rem=num%10
        rev=rev*10+rem
        num=num//10
    if(i<rev):
        count=count+1
        print(i,end=" ")
print()
print("Numbers between 1 and 100 whose reverse is greater than the original number is ", count)


