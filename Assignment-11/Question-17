import pandas as pd
import numpy as np

data = {'Roll No': [1, 2, 3, 4, 5],
    'Name': ['Rahul', 'Amit', 'Sneha', 'Priya', 'Vikas'],
    'Marks1': [85, 72, 90, 78, 95],
    'Marks2': [80, 70, 85, 74, 92],
    'Marks3': [88, 68, 92, 80, 90]}

df = pd.DataFrame(data)
print("Original DataFrame:")
print(df)
print()


Output :
Original DataFrame:
