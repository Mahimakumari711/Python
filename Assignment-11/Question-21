1      Bob   21     A     Math      88      73      90    251   83.666667
2  Charlie   19     B  Physics      74      77      73    224   74.666667
3    Diana   22     B       CS      67      65      77    209   69.666667
4      Eve   20    B+       EE      80      65      93    238   79.333333

----------------------------------------------------------------------------------------------------------------------------------

above_75 = df[df['Percentage'] > 75][['RollNo', 'Name', 'Total', 'Percentage', 'Grade']]
print("Students scoring above 75%:")
print(above_75)
print()

Output :

