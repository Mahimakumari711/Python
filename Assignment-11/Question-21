import pandas as pd

df = pd.read_csv('students.csv')
print("Original DataFrame:")
print(df)
print()

Output :

Original DataFrame:
      Name  Age Grade    Major
0    Alice   20     A       CS
1      Bob   21    B+     Math
2  Charlie   19    A-  Physics
3    Diana   22     B       CS
