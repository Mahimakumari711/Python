----------------------------------------------------------------------------------------------------------------------------------

df['Total'] = df['Marks1'] + df['Marks2'] + df['Marks3']
df['Percentage'] = (df['Total'] / 300) * 100
print("With Total and Percentage:")
print(df)
print()


Output :

With Total and Percentage:
      Name  Age Grade    Major  Marks1  Marks2  Marks3  Total  Percentage
0    Alice   20     A       CS      98      93      93    284   94.666667
1      Bob   21    B+     Math      88      73      90    251   83.666667
2  Charlie   19    A-  Physics      74      77      73    224   74.666667
3    Diana   22     B       CS      67      65      77    209   69.666667
4      Eve   20     A       EE      80      65      93    238   79.333333

---------------------------------------------------------------------------------------------------------------------------------------------

def assign_grade(perc):
    if perc >= 90:
        return 'A+'
    elif perc >= 80:
        return 'A'
    elif perc >= 75:
        return 'B+'
    elif perc >= 60:
        return 'B'
    elif perc >= 40:
        return 'C'
    else:
        return 'F'

df['Grade'] = df['Percentage'].apply(assign_grade)
print("With Grade column:")
print(df)
print()

Output :

With Grade column:
