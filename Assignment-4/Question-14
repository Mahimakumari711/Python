l1=eval(input("Enter the value of first list : "))
l2=eval(input("Enter the value of second list : "))
if (len(l1) != len(l2)) :
    print("Enter both the list or same size.")
else :
    n=len(l1)
    print("{",end="")
    for i in range(n) :
        print("(",l1[i],",",l2[i],")",end=",")
    print("}")


