l = eval(input("Enter the value of list : "))
n = len(l)
for i in range(n):
    swapped = False
    for j in range(0, n - i - 1):
        if l[j] > l[j + 1]:
            l[j], l[j + 1] = l[j + 1], l[j]
            swapped = True
    if not swapped:
        break
print("Sorted list:", l)


Output :
Enter the value of list : [64, 34, 25, 12, 22, 11, 90]
Sorted list: [11, 12, 22, 25, 34, 64, 90]
