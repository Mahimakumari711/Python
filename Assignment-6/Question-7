d1 = eval(input("Enter first dictionary : "))
d2 = eval(input("Enter second dictionary : "))
if d1.items() <= d2.items():
    print("d1 is contained in d2")
elif d2.items() <= d1.items():
    print("d2 is contained in d1")
else:
    print("Neither dictionary is contained in the other")


