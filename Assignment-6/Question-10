friends = {}

n = int(input("Enter the number of friends : "))

for i in range(n):
    name = input("Enter the friend's name : ")
    phone = input("Enter the phone number : ")
    friends[name] = phone

print("\nAll Friends:")
for name, phone in friends.items():
    print(name, " : ", phone)

new_name = input("\nEnter new friend's name : ")
new_phone = input("Enter phone number : ")
friends[new_name] = new_phone
print("After adding new friend details : ", friends)

delete_name = input("\nEnter friend's name to delete : ")
if delete_name in friends:
    del friends[delete_name]
    print("Friend deleted successfully.")
else:
    print("Friend not found.")
print("Dictionary after deleting name : ", friends)

modify_name = input("\nEnter friend's name to modify phone number : ")
if modify_name in friends:
    new_phone = input("Enter new phone number : ")
    friends[modify_name] = new_phone
    print("Phone number updated.")
else:
    print("Friend not found.")
print("Dictionary after changing the phone number : ", friends)

check_name = input("\nEnter friend's name to check : ")
if check_name in friends:
    print("Friend is present in dictionary.")
else:
    print("Friend is not present.")

print("\nFriends in sorted order : ")
for name in sorted(friends):
    print(name, ":", friends[name])



