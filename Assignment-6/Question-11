paragraph = input("Enter a paragraph:\n")
paragraph = paragraph.lower()
words = paragraph.split()
frequency = {}
for word in words:
    word = word.strip(".,!?;:'\"") 
    if word in frequency:
        frequency[word] += 1
    else:
        frequency[word] = 1
print("\nWord Frequency:")
for word, count in frequency.items():
    print(word, ":", count)


