numbers = input("Enter numbers separated by space: ").split(",")
count = {}
for num in numbers:
    num = num.strip()  # Remove extra spaces
    count[num] = count.get(num, 0) + 1

print("\nNumber counts:")
for num, freq in count.items():
    print(f"{num}: {freq}")


