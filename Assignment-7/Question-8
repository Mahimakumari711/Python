def lar(num):
    if num == 0:
        return 0
    largest=0
    while num > 0:
        digit = num % 10
        if digit > largest:
            largest = digit
        num = num // 10
    return largest

n = int(input("Enter the number: "))
print("Largest digit in given number is : ",lar(n))


