def is_perfect(num):
    if num <= 0:
        return False
    
    sum_divisors = 1 
    for i in range(2, int(num**0.5) + 1):
        if num % i == 0:
            sum_divisors += i
            if i != num // i:  
                sum_divisors += num // i
    
    return sum_divisors == num

n = int(input("Enter the number: "))
print("Perfect" if is_perfect(n) else "Not Perfect")


