def fact(n):
    if n == 0 or n == 1:
        return 1
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

def sum_fact(num):
    total = 0  
    
    if num < 0:
        num = abs(num)
    
    while num > 0:
        digit = num % 10
        total += fact(digit)
        num = num // 10
    
    return total

num1=int(input("Enter the number : "))
print(sum_fact(num1))  


