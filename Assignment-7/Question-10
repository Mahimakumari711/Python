def gcd(a, b):
    if b == 0:
        return a
    return gcd(b, a % b)

def lcm (a,b):
    return (a*b)//(gcd(a,b))

n1=int(input("Enter the first number : "))
n2=int(input("Enter the second number : "))

print("LCM of given two number is : ",lcm(n1,n2))


