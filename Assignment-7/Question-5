def count_p(num):
    if num < 0:
        num = -num  
    prime_digits = {2, 3, 5, 7}  
    count = 0
    s = str(num)
    for digit in s:
        d = int(digit)
        if d in prime_digits:
            count += 1
    return count

n = int(input("Enter the number: "))
print(count_p(n))


