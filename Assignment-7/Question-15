def anagrams(s1, s2):
    if len(s1) != len(s2):
        print("Given words are not anagram ")
    
    freq = {}

    for char in s1:
        freq[char] = freq.get(char, 0) + 1
    
    for char in s2:
        if char not in freq or freq[char] == 0:
            print("Given words are not anagram ")
        freq[char] -= 1

    if (count == 0 for count in freq.values()) :
        print("Given words are anagram ")


st1=input("Enter the first string : ")
st2=input("Enter the second string : ")
anagrams(st1,st2)


