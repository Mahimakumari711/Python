arr = input("Enter the element of array : ").split()

def index(arr, i):
    try :
        return arr[i]
    except IndexError :
        return "Index out of range."
i = int(input("Enter the index to access the element : "))
print(index(arr, i))

Output :
Enter the element of array : 12 34 56 78 90
