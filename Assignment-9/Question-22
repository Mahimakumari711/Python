class InvalidAgeError(Exception):
    pass
try:
    age = int(input("Enter your age: "))
    if age < 18:
        raise InvalidAgeError("Not eligible to vote")
    print("Eligible to vote")

except InvalidAgeError as e:
    print("Error:", e)
except ValueError:
    print("Error: Please enter a valid integer age.")


