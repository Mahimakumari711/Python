n=int(input("Enter the number of student : "))
f = open("students.txt", "w")

while (n!=0) :
    user_input = input("Enter name and marks of student : ")
    f.write(user_input + "\n")
    n=n-1;
f.close()

print("Data is stored in students.txt")

print("\nStudents scoring more than 75 marks are : ")
f = open("students.txt", "r")
for line_num, line in enumerate(f, 1):
    parts = line.strip().split()
    if len(parts) == 2:
        name = parts[0]
        marks = int(parts[1])
        if marks > 75:
            print(f" {name}: {marks} marks")
f.close()

