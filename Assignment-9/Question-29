try:
    product_name = input("Enter product name: ")
    stock = int(input("Enter available stock: "))

    while True:
        print("\n1. Purchase Product")
        print("2. Check Stock")
        print("3. Exit")

        choice = input("Enter your choice: ")
        if choice == '1':
            try:
                qty = int(input("Enter quantity to purchase: "))
                if qty > stock:
                    raise Exception("OutOfStockError: Not enough stock available!")
                stock -= qty
                print(f"Purchased {qty} items of {product_name}")
            except Exception as e:
                print("Error:", e)
            except ValueError:
                print("Invalid input! Enter a number.")
        elif choice == '2':
            print(f"Product: {product_name}, Available Stock: {stock}")
        elif choice == '3':
            print("Exiting...")
            break
        else:
            print("Invalid choice!")
except ValueError:
    print("Error: Please enter valid numeric value for stock.")


