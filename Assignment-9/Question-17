n = int(input("Enter array size: "))
arr = input("Enter array elements: ").split()

def safe_get(arr, idx):
    try:
        return arr[idx]
    except IndexError:
        return "Index out of range"
    except TypeError:
        return "Index must be integer"

idx = input("Enter index: ")
print(safe_get(arr, idx))

