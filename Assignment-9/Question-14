f = open("Demo_1.txt", "r")
content = f.read()
f.close()

words = content.split()
reversed_words = []
for word in words:
    reversed_word = word[::-1]  
    reversed_words.append(reversed_word)

out_f = open("reversed_words.txt", "w")
out_f.write(" ".join(reversed_words))
out_f.close()

print("Reversed words stored in reversed_words.txt")
f1=open("reversed_words.txt","r")
f1.read()

