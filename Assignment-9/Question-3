def display(file):
    vowels = ('a', 'e', 'i', 'o', 'u')
    with open(file, 'r') as file:
        f=file.read()
        for line in f:
            if line.strip() and line[0].lower() in vowels:
                print(line.strip(),end=" ")

display("Demo_1")

