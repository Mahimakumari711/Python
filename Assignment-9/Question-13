f = open("Demo_1.txt", "r")
content = f.read().lower()
f.close()

vowels = 0
consonants = 0
vowel_set = "aeiou"

for char in content:
    if char in vowel_set:
        vowels += 1
    elif char.isalpha():
        consonants += 1

print(f"Vowels: {vowels}")
print(f"Consonants: {consonants}")

Output :

Vowels: 34
Consonants: 51
