Method 1 :

f = open("Demo_1.txt")
file = f.read()

word = {}
for ch in file.split():
    word[ch] = word.get(ch, 0) + 1
    
for key, value in word.items():
    print(key, ":", value)




Method 2 :

with open("Demo_1.txt") as f:
    file = f.read()

word = {}
for ch in file.split():
    word[ch] = word.get(ch, 0) + 1
    
for key, value in word.items():
    print(key, ":", value)




